#!/bin/sh
set -eu

ROOT="/usr/local/share/lightnode-host-relay"

usage() {
  cat >&2 <<'EOF'
usage:
  sudo lightnode-host-relay configure HOST_CONF [GUEST_IP]
  sudo lightnode-host-relay doctor
  sudo lightnode-host-relay uninstall [--purge]
EOF
  exit 2
}

[ "$(id -u)" -eq 0 ] || { echo "run with sudo" >&2; exit 1; }

case "${1:-}" in
  configure)
    [ "$#" -ge 2 ] && [ "$#" -le 3 ] || usage
    host_user="$(stat -f '%Su' /dev/console)"
    [ -n "$host_user" ] && [ "$host_user" != root ] || { echo "cannot determine the logged-in user" >&2; exit 1; }
    guest_ip="${3:-10.211.55.4}"
    exec env \
      LIGHTNODE_HOST_RELAY_ROOT="$ROOT" \
      LIGHTNODE_HOST_RELAY_TOOLS="/usr/local/libexec/lightnode-host-relay/bin" \
      "$ROOT/scripts/install-host-relay.sh" \
      --wireguard-config "$2" \
      --host-user "$host_user" \
      --guest-ip "$guest_ip"
    ;;
  doctor)
    [ "$#" -eq 1 ] || usage
    exec "$ROOT/scripts/doctor-host-relay.sh"
    ;;
  uninstall)
    [ "$#" -le 2 ] || usage
    mode="${2:---yes}"
    exec "$ROOT/scripts/uninstall-host-relay.sh" "$mode"
    ;;
  *) usage ;;
esac
