#!/usr/bin/env bash
set -euo pipefail

action="${1:-}"
wg_interface="${2:-wg0}"
host_peer="${HOST_PEER_ADDRESS:-10.88.0.2}"
hairpin_address="${HAIRPIN_ADDRESS:-10.88.0.254}"
guest_address="${GUEST_ADDRESS:-10.211.55.4}"
tcp_ports="47984,47989,48010"
udp_ports="47998,47999,48000,48002,48010"
dnat_chain="LIGHTNODE_SUNSHINE_DNAT"
snat_chain="LIGHTNODE_SUNSHINE_SNAT"

delete_all() {
  local table="$1"
  local chain="$2"
  shift 2
  while /usr/sbin/iptables -t "$table" -C "$chain" "$@" 2>/dev/null; do
    /usr/sbin/iptables -t "$table" -D "$chain" "$@"
  done
}

down() {
  delete_all filter FORWARD -i "$wg_interface" -o "$wg_interface" -m conntrack --ctstate RELATED,ESTABLISHED -j ACCEPT
  delete_all filter FORWARD -i "$wg_interface" -o "$wg_interface" -s 10.88.0.0/24 -d "$guest_address" -p tcp -m multiport --dports "$tcp_ports" -j ACCEPT
  delete_all filter FORWARD -i "$wg_interface" -o "$wg_interface" -s 10.88.0.0/24 -d "$guest_address" -p udp -m multiport --dports "$udp_ports" -j ACCEPT
  delete_all filter FORWARD -i "$wg_interface" -o "$wg_interface" -j ACCEPT
  delete_all nat PREROUTING -i "$wg_interface" -s "$host_peer" -d "$hairpin_address" -j "$dnat_chain"
  delete_all nat POSTROUTING -o "$wg_interface" -s "$host_peer" -d "$guest_address" -j "$snat_chain"
  /usr/sbin/iptables -t nat -F "$dnat_chain" 2>/dev/null || true
  /usr/sbin/iptables -t nat -X "$dnat_chain" 2>/dev/null || true
  /usr/sbin/iptables -t nat -F "$snat_chain" 2>/dev/null || true
  /usr/sbin/iptables -t nat -X "$snat_chain" 2>/dev/null || true
}

up() {
  /usr/sbin/sysctl -w net.ipv4.ip_forward=1 >/dev/null
  /usr/sbin/sysctl -w "net.ipv4.conf.${wg_interface}.rp_filter=0" >/dev/null

  /usr/sbin/iptables -C FORWARD -i "$wg_interface" -o "$wg_interface" -s 10.88.0.0/24 -d "$guest_address" -p udp -m multiport --dports "$udp_ports" -j ACCEPT 2>/dev/null || \
    /usr/sbin/iptables -I FORWARD 1 -i "$wg_interface" -o "$wg_interface" -s 10.88.0.0/24 -d "$guest_address" -p udp -m multiport --dports "$udp_ports" -j ACCEPT
  /usr/sbin/iptables -C FORWARD -i "$wg_interface" -o "$wg_interface" -s 10.88.0.0/24 -d "$guest_address" -p tcp -m multiport --dports "$tcp_ports" -j ACCEPT 2>/dev/null || \
    /usr/sbin/iptables -I FORWARD 1 -i "$wg_interface" -o "$wg_interface" -s 10.88.0.0/24 -d "$guest_address" -p tcp -m multiport --dports "$tcp_ports" -j ACCEPT
  /usr/sbin/iptables -C FORWARD -i "$wg_interface" -o "$wg_interface" -m conntrack --ctstate RELATED,ESTABLISHED -j ACCEPT 2>/dev/null || \
    /usr/sbin/iptables -I FORWARD 1 -i "$wg_interface" -o "$wg_interface" -m conntrack --ctstate RELATED,ESTABLISHED -j ACCEPT

  /usr/sbin/iptables -t nat -N "$dnat_chain" 2>/dev/null || true
  /usr/sbin/iptables -t nat -N "$snat_chain" 2>/dev/null || true
  /usr/sbin/iptables -t nat -F "$dnat_chain"
  /usr/sbin/iptables -t nat -F "$snat_chain"

  /usr/sbin/iptables -t nat -C PREROUTING -i "$wg_interface" -s "$host_peer" -d "$hairpin_address" -j "$dnat_chain" 2>/dev/null || \
    /usr/sbin/iptables -t nat -I PREROUTING 1 -i "$wg_interface" -s "$host_peer" -d "$hairpin_address" -j "$dnat_chain"
  /usr/sbin/iptables -t nat -C POSTROUTING -o "$wg_interface" -s "$host_peer" -d "$guest_address" -j "$snat_chain" 2>/dev/null || \
    /usr/sbin/iptables -t nat -I POSTROUTING 1 -o "$wg_interface" -s "$host_peer" -d "$guest_address" -j "$snat_chain"

  /usr/sbin/iptables -t nat -A "$dnat_chain" -p tcp -m multiport --dports "$tcp_ports" -j DNAT --to-destination "$guest_address"
  /usr/sbin/iptables -t nat -A "$dnat_chain" -p udp -m multiport --dports "$udp_ports" -j DNAT --to-destination "$guest_address"
  /usr/sbin/iptables -t nat -A "$snat_chain" -p tcp -m multiport --dports "$tcp_ports" -j SNAT --to-source 10.88.0.1
  /usr/sbin/iptables -t nat -A "$snat_chain" -p udp -m multiport --dports "$udp_ports" -j SNAT --to-source 10.88.0.1
}

case "$action" in
  up) up ;;
  down) down ;;
  *) echo "usage: lightnode-relay-rules up|down [wg-interface]" >&2; exit 2 ;;
esac
