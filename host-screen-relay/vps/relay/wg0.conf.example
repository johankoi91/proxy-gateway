[Interface]
Address = 10.88.0.1/24
ListenPort = 443
PrivateKey = REPLACE_SERVER_PRIVATE_KEY
MTU = 1380
PostUp = /usr/local/sbin/lightnode-relay-rules up %i
PostDown = /usr/local/sbin/lightnode-relay-rules down %i

# UTM host relay. The guest /32 is routed to this peer.
[Peer]
PublicKey = REPLACE_HOST_PUBLIC_KEY
AllowedIPs = 10.88.0.2/32, 10.211.55.4/32

