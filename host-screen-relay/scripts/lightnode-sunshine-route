#!/bin/sh
set -eu

ANCHOR="com.apple.internet-sharing/lightnode-sunshine-route"
PARENT_ANCHOR="com.apple.internet-sharing"
RULES="/etc/pf.anchors/com.lightnode.sunshine-route"
PARENT_RULES="/etc/pf.anchors/com.lightnode.internet-sharing-parent"
CONFIG="/Library/Application Support/LightNodeHostRelay/relay.conf"
TOKEN=""
LAST_IF=""

HOST_WG_ADDRESS="$(/usr/bin/awk -F= '$1 == "HOST_WG_ADDRESS" { print $2 }' "$CONFIG")"
[ -n "$HOST_WG_ADDRESS" ] || { echo "HOST_WG_ADDRESS is missing" >&2; exit 1; }

cleanup() {
  /sbin/pfctl -a "$ANCHOR" -F all >/dev/null 2>&1 || true
  if [ -n "$TOKEN" ]; then
    /sbin/pfctl -X "$TOKEN" >/dev/null 2>&1 || true
  fi
}
trap cleanup EXIT INT TERM

/usr/sbin/sysctl -w net.inet.ip.forwarding=1 >/dev/null
TOKEN="$(/sbin/pfctl -E 2>&1 | /usr/bin/sed -n 's/.*Token : \([0-9]*\).*/\1/p')"

while :; do
  WG_IF="$(/sbin/ifconfig -l | /usr/bin/tr ' ' '\n' | while read -r iface; do
    /sbin/ifconfig "$iface" 2>/dev/null | /usr/bin/grep -Fq "inet $HOST_WG_ADDRESS " && { echo "$iface"; break; }
  done)"
  NEEDS_RELOAD=0
  PARENT_FILTER_RULES="$(/sbin/pfctl -a "$PARENT_ANCHOR" -sr 2>/dev/null || true)"
  PARENT_NAT_RULES="$(/sbin/pfctl -a "$PARENT_ANCHOR" -sn 2>/dev/null || true)"
  if [ "$WG_IF" != "$LAST_IF" ]; then
    NEEDS_RELOAD=1
  elif ! printf '%s\n%s\n' "$PARENT_FILTER_RULES" "$PARENT_NAT_RULES" | /usr/bin/grep -q 'lightnode-sunshine-route'; then
    NEEDS_RELOAD=1
  elif [ -n "$WG_IF" ]; then
    FILTER_RULES="$(/sbin/pfctl -a "$ANCHOR" -sr 2>/dev/null || true)"
    if ! printf '%s\n' "$FILTER_RULES" | /usr/bin/grep -q '10\.211\.55\.4' || \
       ! printf '%s\n' "$FILTER_RULES" | /usr/bin/grep -q 'route-to'; then
      NEEDS_RELOAD=1
    fi
  fi
  if [ "$NEEDS_RELOAD" -eq 1 ]; then
    if [ -n "$WG_IF" ]; then
      /usr/bin/sed "s/lightnode-wg/$WG_IF/g" "$RULES" | /sbin/pfctl -a "$ANCHOR" -f -
      /sbin/pfctl -a "$PARENT_ANCHOR" -f "$PARENT_RULES"
    else
      /sbin/pfctl -a "$ANCHOR" -F all >/dev/null 2>&1 || true
    fi
    LAST_IF="$WG_IF"
  fi
  /bin/sleep 10
done
