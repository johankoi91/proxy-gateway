sunshine_tcp = "{ 47984, 47989, 48010 }"
sunshine_udp = "{ 47998, 47999, 48000, 48002, 48010 }"

# The host itself can reach the guest directly over bridge100. Translate and
# route fresh host-originated Sunshine flows into WireGuard so they cannot
# bypass the Guangzhou relay after Moonlight learns the guest's local address.
nat on bridge100 inet proto tcp from 10.211.55.1 to 10.211.55.4 port $sunshine_tcp -> 10.88.0.2
nat on bridge100 inet proto udp from 10.211.55.1 to 10.211.55.4 port $sunshine_udp -> 10.88.0.2
nat on bridge100 inet from 10.88.0.0/24 to 10.211.55.4 -> 10.211.55.1

pass out quick on bridge100 route-to (lightnode-wg 10.88.0.1) inet proto tcp from 10.211.55.1 to 10.211.55.4 port $sunshine_tcp user hanxiaoqing flags S/SA keep state
pass out quick on bridge100 route-to (lightnode-wg 10.88.0.1) inet proto udp from 10.211.55.1 to 10.211.55.4 port $sunshine_udp user hanxiaoqing keep state
pass in quick on lightnode-wg inet proto tcp from 10.88.0.0/24 to 10.211.55.4 port $sunshine_tcp flags S/SA keep state
pass in quick on lightnode-wg inet proto udp from 10.88.0.0/24 to 10.211.55.4 port $sunshine_udp keep state
pass in quick on lightnode-wg inet proto icmp from 10.88.0.0/24 to 10.211.55.4 icmp-type echoreq keep state
block drop in quick on lightnode-wg inet from 10.88.0.0/24 to 10.211.55.0/24
