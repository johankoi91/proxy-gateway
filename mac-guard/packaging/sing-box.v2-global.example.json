{
  "log": {
    "level": "info",
    "timestamp": true
  },
  "dns": {
    "servers": [
      {
        "type": "https",
        "tag": "dns-ai",
        "server": "104.16.249.249",
        "server_port": 443,
        "path": "/dns-query",
        "tls": {
          "enabled": true,
          "server_name": "cloudflare-dns.com"
        },
        "detour": "ai-fixed"
      }
    ],
    "strategy": "ipv4_only",
    "final": "dns-ai"
  },
  "inbounds": [
    {
      "type": "tun",
      "tag": "tun-in",
      "address": ["172.19.0.1/30"],
      "mtu": 1280,
      "dns_mode": "hijack",
      "auto_route": true,
      "strict_route": true
    }
  ],
  "outbounds": [
    {
      "type": "vless",
      "tag": "ai-fixed",
      "server": "149.104.78.121",
      "server_port": 443,
      "uuid": "REPLACE_VLESS_UUID",
      "flow": "xtls-rprx-vision",
      "tls": {
        "enabled": true,
        "server_name": "www.cloudflare.com",
        "reality": {
          "enabled": true,
          "public_key": "REPLACE_REALITY_PUBLIC_KEY",
          "short_id": "REPLACE_REALITY_SHORT_ID"
        },
        "utls": {
          "enabled": true,
          "fingerprint": "chrome"
        }
      }
    }
  ],
  "route": {
    "auto_detect_interface": true,
    "rules": [
      {
        "protocol": "dns",
        "action": "hijack-dns"
      },
      {
        "inbound": ["tun-in"],
        "action": "sniff"
      },
      {
        "process_path_regex": [
          "^/Applications/(Claude|ChatGPT)\\.app/"
        ],
        "action": "route",
        "outbound": "ai-fixed"
      },
      {
        "domain_suffix": [
          "claude.ai",
          "claude.com",
          "anthropic.com",
          "chatgpt.com",
          "openai.com",
          "oaistatic.com",
          "oaiusercontent.com"
        ],
        "action": "route",
        "outbound": "ai-fixed"
      }
    ],
    "final": "ai-fixed"
  },
  "experimental": {
    "clash_api": {
      "external_controller": "127.0.0.1:9090",
      "secret": "REPLACE_CLASH_API_SECRET",
      "access_control_allow_origin": [
        "http://127.0.0.1:9180"
      ],
      "access_control_allow_private_network": false
    }
  }
}
