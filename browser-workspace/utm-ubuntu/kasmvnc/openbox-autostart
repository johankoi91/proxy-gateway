#!/bin/sh
xsetroot -solid '#1e2328'
fcitx5 -d --replace &
(
  while true; do
    chromium \
      --no-sandbox \
      --no-first-run \
      --no-default-browser-check \
      --disable-background-networking \
      --disable-features=Translate \
      --disable-quic \
      --lang=zh-CN \
      --accept-lang=zh-CN,zh,en-US,en \
      --start-maximized \
      about:blank
    sleep 2
  done
) &
