#!/bin/sh
set -eu

ROOT="/usr/local/share/lightnode-browser-host"

usage() {
  cat >&2 <<'EOF'
usage:
  sudo lightnode-browser-host configure HOST_CONF [GUEST_IP]
  sudo lightnode-browser-host doctor
  sudo lightnode-browser-host uninstall [--purge]
EOF
  exit 2
}

[ "$(id -u)" -eq 0 ] || { echo "run with sudo" >&2; exit 1; }

case "${1:-}" in
  configure)
    [ "$#" -ge 2 ] && [ "$#" -le 3 ] || usage
    exec env \
      LIGHTNODE_BROWSER_HOST_ROOT="$ROOT" \
      LIGHTNODE_BROWSER_HOST_TOOLS="/usr/local/libexec/lightnode-browser-host/bin" \
      "$ROOT/scripts/install-browser-host.sh" \
      --wireguard-config "$2" \
      --guest-ip "${3:-10.211.55.7}"
    ;;
  doctor)
    [ "$#" -eq 1 ] || usage
    exec "$ROOT/scripts/doctor-browser-host.sh"
    ;;
  uninstall)
    [ "$#" -le 2 ] || usage
    exec "$ROOT/scripts/uninstall-browser-host.sh" "${2:---yes}"
    ;;
  *) usage ;;
esac
