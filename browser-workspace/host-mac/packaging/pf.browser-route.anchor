kasm_port = "8443"

nat on bridge100 inet proto tcp from 10.88.0.0/24 to 10.211.55.7 port $kasm_port -> 10.211.55.1
nat on bridge100 inet proto udp from 10.88.0.0/24 to 10.211.55.7 port $kasm_port -> 10.211.55.1

rdr on lightnode-wg inet proto tcp from 10.88.0.0/24 to 10.88.0.2 port $kasm_port -> 10.211.55.7
rdr on lightnode-wg inet proto udp from 10.88.0.0/24 to 10.88.0.2 port $kasm_port -> 10.211.55.7

pass in quick on lightnode-wg inet proto tcp from 10.88.0.0/24 to 10.211.55.7 port $kasm_port flags S/SA keep state
pass in quick on lightnode-wg inet proto udp from 10.88.0.0/24 to 10.211.55.7 port $kasm_port keep state
block drop in quick on lightnode-wg inet from 10.88.0.0/24 to 10.211.55.0/24
